# Copy to .env (never commit .env). All values optional; defaults are safe.
EXECUTION_MODE=PAPER
ENABLE_MANIFOLD_ORDERS=false
# MANIFOLD_API_KEY=
MANIFOLD_BASE_URL=https://api.manifold.markets
DATABASE_URL=sqlite:///./var/ambre.db
INITIAL_CAPITAL=1000
MAX_MARKETS_PER_CYCLE=200
# AMBRE_CONFIG=configs/default.yaml

# PostgreSQL optionnel (docker compose up -d), puis :
# POSTGRES_USER=ambre
# POSTGRES_PASSWORD=<à choisir>
# POSTGRES_DB=ambre
# Le mot de passe de DATABASE_URL doit être identique à POSTGRES_PASSWORD, encodé pour une URL
# (choisir de préférence des caractères hexadécimaux : `openssl rand -hex 16`).
# DATABASE_URL=postgresql+psycopg://ambre:<mot de passe>@localhost:5432/ambre
